@page "/auth/signup"
@model Roblox.Website.Pages.Auth.Signup
@{
    Layout = null;
    var asset = "/legacy-signup-assets/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>RUBLON</title>
    <link rel="icon" href="@asset/logo_rb.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,500,600,700" />
    <script src="https://js.hcaptcha.com/1/api.js" async defer></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const input = document.getElementById("signup-username");
            if (!input) return;
            const blockedWords = [
                "nigga", "nigger", "fuck", "fucker", "fucking", "motherfucker",
                "bitch", "bitches", "shit", "shitty", "asshole", "dick", "dicks",
                "pussy", "cunt", "whore", "slut", "fag", "faggot", "retard",
                "porn", "hentai"
            ];
            input.addEventListener("input", function () {
                this.value = this.value.replace(/[^A-Za-z0-9_]/g, "");
                const firstUnderscore = this.value.indexOf("_");
                if (firstUnderscore !== -1) {
                    this.value = this.value.slice(0, firstUnderscore + 1) + this.value.slice(firstUnderscore + 1).replace(/_/g, "");
                }
                if (this.value.startsWith("_")) this.value = this.value.slice(1);
                if (this.value.endsWith("_")) this.value = this.value.slice(0, -1);
                const lower = this.value.toLowerCase();
                const isBlocked = blockedWords.some(word => lower.includes(word));
                this.setCustomValidity(isBlocked ? "This username contains a word that is not allowed." : "");
            });
        });
    </script>
    <style>
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; min-height: 100%; }
        body { font-family: "Source Sans Pro", Arial, sans-serif; color: #444; background: #fff; }
        a { text-decoration: none; }

        .navbar-landing {
            height: 64px;
            width: 100%;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 100;
            background: rgba(255,255,255,.98);
            border-bottom: 1px solid #ddd;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }
        .navbar-inner { max-width: 1170px; height: 64px; margin: 0 auto; padding: 0 15px; display: flex; align-items: center; }
        .navbar-brand { width: 76px; height: 64px; display: flex; align-items: center; }
        .navbar-brand img { width: 50px; height: 50px; object-fit: contain; }
        .top-nav { display: flex; align-items: center; margin-left: 20px; height: 100%; }
        .top-nav a { color: #555; font-size: 16px; padding: 22px 17px 20px; height: 64px; }
        .top-nav a:hover, .top-nav a.active { color: #00a2ff; }
        .top-nav a.active { border-bottom: 3px solid #00a2ff; }
        .login-area { margin-left: auto; display: flex; align-items: center; gap: 7px; }
        .login-area input { width: 125px; height: 34px; border: 1px solid #bbb; border-radius: 3px; padding: 7px 9px; font-family: inherit; font-size: 14px; }
        .login-area button { height: 34px; border: 1px solid #777; border-radius: 3px; padding: 0 13px; background: #fff; color: #444; font-family: inherit; font-size: 14px; cursor: pointer; }
        .login-area button:hover { background: #f4f4f4; }
        .forgot { color: #777; font-size: 12px; margin-left: 4px; white-space: nowrap; }
        .forgot:hover { color: #00a2ff; }
        .quick-login-captcha { display: flex; align-items: center; margin: 0 2px; }
        .quick-login-captcha .h-captcha { transform: scale(.78); transform-origin: left center; width: 230px; }

        .roller-container {
            min-height: 680px;
            margin-top: 64px;
            position: relative;
            background: #eee url('@asset/dcbdfaf1c08058e71f65c09f7b98ff04.jpg') center center / cover no-repeat;
        }
        .roller-container::before { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.06); }
        .roller-inner { max-width: 1170px; min-height: 680px; margin: 0 auto; padding: 80px 15px 55px; position: relative; display: flex; align-items: center; }
        .main-logo-col { width: 50%; padding: 0 15px; }
        .main-logo { text-align: center; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,.35); }
        .main-logo img { width: : 400px; max-width: 100%; height: auto; display: block; margin: 0 auto 12px; }
        .main-logo h1 { font-size: 25px; line-height: 1.2; font-weight: 400; margin: 0; }
        .main-logo h1 span { font-size: 12px; vertical-align: top; }

        .signup-col { width: 50%; padding: 0 15px; }
        .signup-box { width: 400px; max-width: 100%; margin: 0 auto; background: #fff; border: 1px solid #d5d5d5; border-radius: 4px; box-shadow: 0 2px 7px rgba(0,0,0,.20); padding: 20px 24px 23px; }
        .signup-header { color: #555; font-size: 24px; line-height: 1.25; font-weight: 400; text-align: center; margin: 0 0 18px; }
        .form-group { margin-bottom: 10px; }
        .input-field { width: 100%; height: 42px; padding: 9px 12px; border: 1px solid #c7c7c7; border-radius: 3px; background: #fff; color: #444; font-family: inherit; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,.04); }
        .input-field:focus { outline: none; border-color: #00a2ff; box-shadow: 0 0 3px rgba(0,162,255,.35); }
        .input-validation { min-height: 0; color: #d9534f; font-size: 12px; margin: 3px 0 0; }
        .legal-text-container { color: #777; font-size: 12px; line-height: 1.45; margin: 12px 0 15px; text-align: center; }
        .legal-text-container a { color: #00a2ff; }
        .captcha-container { min-height: 78px; display: flex; justify-content: center; align-items: center; margin: 2px 0 12px; }
        .signup-submit-button { width: 100%; height: 42px; border: 0; border-radius: 3px; background: #02b757; color: #fff; font-family: inherit; font-size: 18px; font-weight: 600; cursor: pointer; box-shadow: inset 0 -2px rgba(0,0,0,.12); }
        .signup-submit-button:hover { background: #00a94f; }
        .signup-submit-button:disabled { opacity: .55; cursor: default; }
        .error-message { margin-bottom: 12px; padding: 9px 11px; border: 1px solid #e1b4b4; border-radius: 3px; background: #fff0f0; color: #a33; font-size: 13px; }

        .what-section { min-height: 640px; position: relative; background: #fff url('@asset/cca69eca62f23ca413fc920549e936ea.jpg') center center / cover no-repeat; padding: 95px 15px 0; }
        .what-box { width: 470px; max-width: 90%; margin-left: 50%; background: rgba(255,255,255,.91); padding: 28px 34px; color: #444; }
        .what-box h1 { margin: 0 0 15px; font-size: 31px; font-weight: 400; text-align: center; }
        .what-box p { margin: 0; font-size: 17px; line-height: 1.55; text-align: justify; }
        .game-strip { display: flex; position: absolute; bottom: 0; left: 0; right: 0; height: 205px; overflow: hidden; }
        .game-image { flex: 1; background-position: center; background-size: cover; border-right: 5px solid #fff; }
        .game-image:last-child { border-right: 0; }

        .device-section { background: #fff; padding: 70px 15px 65px; text-align: center; }
        .device-section h2 { margin: 0 0 15px; color: #444; font-size: 29px; font-weight: 400; }
        .device-section p { max-width: 760px; margin: 0 auto 30px; color: #777; font-size: 17px; line-height: 1.55; }
        .device-section .device-image { max-width: 100%; width: 900px; height: auto; display: block; margin: 0 auto 25px; }
        .stores { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 13px; list-style: none; margin: 0; padding: 0; }
        .stores img { width: 145px; height: auto; }

        footer { background: #f5f5f5; border-top: 1px solid #ddd; padding: 25px 15px; text-align: center; color: #888; font-size: 12px; }
        .footer-links { margin-bottom: 9px; }
        .footer-links a { color: #777; margin: 0 9px; }
        .footer-links a:hover { color: #00a2ff; }

        @@media (max-width: 900px) {
            .login-area { display: flex; flex-wrap: wrap; justify-content: center; margin: 8px auto 0; }
            .quick-login-captcha { display: flex; width: 100%; justify-content: center; margin-top: 6px; }
            .roller-inner { min-height: 850px; padding-top: 50px; flex-direction: column; justify-content: center; }
            .main-logo-col, .signup-col { width: 100%; }
            .main-logo-col { margin-bottom: 35px; }
            .main-logo img { width: 235px; }
            .signup-box { width: 420px; }
            .what-box { margin: 0 auto; }
        }
        @@media (max-width: 600px) {
            .top-nav { display: none; }
            .navbar-inner { justify-content: center; }
            .navbar-brand { margin-right: auto; }
            .roller-container, .roller-inner { min-height: 800px; }
            .roller-inner { padding: 35px 10px; }
            .main-logo-col { display: none; }
            .signup-col { padding: 0; }
            .signup-box { padding: 18px 16px 20px; }
            .what-section { min-height: 700px; padding-top: 35px; }
            .what-box { max-width: 100%; padding: 24px 20px; }
            .game-strip { height: 150px; }
            .game-image:nth-child(n+2) { display: none; }
        }
    </style>
</head>
<body>
    <header class="navbar-landing">
        <div class="navbar-inner">
            <a class="navbar-brand" href="/"><img src="@asset/logo_rb.png" alt="Roblox" /></a>
            <nav class="top-nav">
                <a class="active" href="#RollerContainer">Play</a>
                <a href="#WhatsRobloxContainer">About</a>
                <a href="#RobloxDeviceText">Platforms</a>
            </nav>
            <form id="quick-login-form" class="login-area" method="post" action="/login" autocomplete="on">
                @Html.AntiForgeryToken()
                <input name="username" type="text" placeholder="Username" autocomplete="username" autocapitalize="off" spellcheck="false" required />
                <input name="password" type="password" placeholder="Password" autocomplete="current-password" required />
                <button id="quick-login-button" type="submit">Log In</button>
                <a class="forgot" href="/auth/password-reset">Forgot?</a>
            </form>
        </div>
    </header>

    <section class="roller-container" id="RollerContainer">
        <div class="roller-inner">
            <div class="main-logo-col">
                <div class="main-logo">
                    <img src="@asset/rb_logo.png" alt="ROBLOX" />
                    <h1>Powering Imagination<span>™</span></h1>
                </div>
            </div>

            <div class="signup-col">
                <div class="signup-box">
                    <h3 class="signup-header">Sign up and start having fun!</h3>

                    @if (Model.errorMessage != null)
                    {
                        <div class="error-message">@Model.errorMessage</div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <input id="signup-username" name="username" class="input-field" type="text" minlength="3" maxlength="21" pattern="[A-Za-z0-9]+(?:_[A-Za-z0-9]+)?" autocomplete="username" autocapitalize="off" spellcheck="false" placeholder="Username (3-21 letters/numbers, max 1 underscore)" value="@Model.username" required />
                        </div>
                        <div class="form-group">
                            <input id="signup-password" name="password" class="input-field" type="password" autocomplete="new-password" placeholder="Password (minimum length 8)" required />
                        </div>
                        <div class="form-group">
                            <input id="signup-password-confirm" name="passwordConfirm" class="input-field" type="password" autocomplete="new-password" placeholder="Confirm Password" required />
                        </div>

                        <div class="legal-text-container">
                            By signing up you agree to our
                            <a href="/auth/tos" target="_blank">Terms</a> and
                            <a href="/auth/privacy" target="_blank">Privacy Policy</a>
                        </div>

                        <div class="captcha-container">
                            <div class="h-captcha" data-sitekey="@Model.siteKey"></div>
                        </div>

                        <button id="signup-button" type="submit" class="signup-submit-button" @(Model.signupDisabled ? "disabled" : "")>Sign Up</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <section class="what-section" id="WhatsRobloxContainer">
        <div class="what-box">
            <h1>WHAT IS RUBLON?</h1>
            <p>RUBLON is the best place to Imagine with Friends™. With a large user-generated online gaming platform, players come to RUBLON to create adventures, play games, role play, and learn with their friends in a family-friendly, immersive, 3D environment.</p>
        </div>
        <div class="game-strip">
            <div class="game-image" style="background-image:url('@asset/42268b6264d89827401ef912f174f288.jpg')"></div>
            <div class="game-image" style="background-image:url('@asset/04baeb33ef66ef1395cd5464309fece6.jpg')"></div>
            <div class="game-image" style="background-image:url('@asset/dcbdfaf1c08058e71f65c09f7b98ff04.jpg')"></div>
        </div>
    </section>

    <section class="device-section" id="RobloxDeviceText">
        <h2>RUBLON ON YOUR DEVICE</h2>
        <p>You can access RUBLON on PC, Mac, iOS, Android, Amazon Devices, and Xbox One. RUBLON adventures are accessible from any device, so players can imagine with their friends regardless of where they are.</p>
        <img class="device-image" src="@asset/9edeef823842e76479587a57c05cb5bc.png" alt="ROBLOX on your devices" />
        <div class="stores">
            <img src="@asset/75ba3866ee59c113220b369c2432c7f9.png" alt="Google Play" />
            <img src="@asset/29d56f5d7a8c1d6d4a267b28134e221d.png" alt="Amazon" />
            <img src="@asset/cfbff08ccdfe3e51898dfecf5635dc2a.png" alt="Xbox" />
            <img src="@asset/6e6e44a25ac2fc28a678880c2fec24a9.png" alt="Windows" />
        </div>
    </section>

    <footer>
        <div class="footer-links">
            <a href="/auth/tos">Terms</a> |
            <a href="/auth/privacy">Privacy</a> |
            <a href="/auth/contact">Help</a> |
            <a href="/auth/login">Log In</a>
        </div>
        ©2016 RUBLON Corporation
    </footer>

    <script>
        document.getElementById("quick-login-form").addEventListener("submit", function (event) {
            var username = this.querySelector('input[name="username"]');
            var password = this.querySelector('input[name="password"]');
            if (!username.value.trim()) {
                event.preventDefault();
                username.focus();
                return;
            }
            if (!password.value) {
                event.preventDefault();
                password.focus();
            }
        });
    </script>
</body>
</html>